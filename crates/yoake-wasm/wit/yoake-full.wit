    draw-world-textured-quad: func(color: u32, corners: list<vec3>, texture: borrow<gui-texture>, uv: box2) -> result<_, string>;
    draw-world-billboard: func(center: vec3, color: u32, size: vec2, texture: borrow<gui-texture>, uv: box2) -> result<_, string>;
    draw-post-tint: func(color: u32) -> result<_, string>;
    draw-post-vignette: func(color: u32) -> result<_, string>;
    register-post-shader: func(id: string, uniform-size: u32, wgsl: string) -> result<_, string>;
    unregister-post-shader: func(id: string) -> result<_, string>;
    set-post-shader-uniforms: func(bytes: list<u8>, id: string) -> result<_, string>;
