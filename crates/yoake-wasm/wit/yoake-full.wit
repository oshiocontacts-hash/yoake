interface client-types {
    enum hud-corner {
        top-left,
        top-right,
        bottom-left,
        bottom-right,
    }

    record box2 {
        height: f32,
        width: f32,
        x: f32,
        y: f32,
    }

    record camera-override {
        fov-degrees: f32,
        pitch: f32,
        position: vec3,
        roll: f32,
        yaw: f32,
    }

    record camera-state {
        dimension: string,
        eye-height: f32,
        far: f32,
        fov-degrees: f32,
        near: f32,
        partial-tick: f32,
        pitch: f32,
        position: vec3,
        projection: list<f32>,
        view: list<f32>,
        yaw: f32,
    }

    record item-stack {
        components: list<u8>,
        count: u32,
        item: string,
    }

    record key-state {
        down: bool,
    }

    record map-entity {
        id: u32,
        kind: string,
        position: vec3,
        yaw: f32,
    }

    record map-player {
        dimension: string,
        name: string,
        position: vec3,
        uuid: string,
        yaw: f32,
    }

    record map-tile {
        color: list<u8>,
        depth: list<u8>,
        height: list<s16>,
    }

    record pcm-anchor {
        entity: option<u32>,
        position: option<vec3>,
    }

    record slot-rect {
        bounds: box2,
        slot: u32,
    }

    record vec2 {
        x: f32,
        y: f32,
    }

    record vec3 {
        x: f64,
        y: f64,
        z: f64,
    }

    record view-hit {
        block: option<tuple<s32, s32, s32>>,
        entity: option<u32>,
        face: option<tuple<s32, s32, s32>>,
        position: vec3,
        uuid: option<string>,
    }
}

/// Services listed in `abi-subset-client.json`.
interface client-services {
    use client-types.{hud-corner, box2, camera-override, camera-state, item-stack, key-state, map-entity, map-player, map-tile, pcm-anchor, slot-rect, vec2, vec3, view-hit};

    use hud.{gui-texture};

    use server-types.{storage-scope, config-value};

    register-key-binding: func(category: string, default-key: string, id: string, label: string) -> result<_, string>;
    key-binding-state: func(id: string) -> result<key-state, string>;
    client-view-hit: func(max-distance: f64) -> result<option<view-hit>, string>;
