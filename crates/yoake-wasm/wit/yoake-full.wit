package yoake:mods@1.0.0;

// @generated by horizon-mod-api-gen; do not edit.
// Every native hook of the catalog, typed from the Rust hook signatures.
// Side rule: an explicit catalog side wins; else the Rust target path decides
// (render/lib crates are client, world/server crates and GameLevel hooks are server);
// the remaining Game hooks run on both and appear in both interfaces.
// Types: plain Rust structs/enums become records/enums/variants; NBT is `nbt` (network
// bytes), item stacks `item-stack`, text `text-json`, JSON values `json`; `&mut` draw objects
// become command lists the guest returns; anything else is a `u64` opaque engine handle
// (documented per field). See coverage.json.

interface engine-types {
    record anvil-craft {
        left: option<item-stack>,
        right: option<item-stack>,
        output: item-stack,
    }

    record apply-effect-tick-outcome {
        /// The new `keep`, or none to leave it unchanged.
        keep: option<bool>,
    }

    record arrow-loose-outcome {
        cancel: bool,
        /// The new `charge`, or none to leave it unchanged.
        charge: option<s32>,
    }

    record biome-colors-outcome {
        /// The new `colors`, or none to leave it unchanged.
        colors: option<biome-colors-type>,
    }

    record biome-colors-type {
        grass: u32,
        foliage: u32,
        dry-foliage: u32,
        water: u32,
    }

    enum blend {
        textured,
        vignette,
        nausea,
        crosshair,
    }

    record block-entity-tick-outcome {
        /// The new `entity`, or none to leave it unchanged.
        entity: option<mod-block-entity-fields>,
    }

    record block-entity-ticks-outcome {
        /// The new `ticks`, or none to leave it unchanged.
        ticks: option<bool>,
    }

    record block-exp-outcome {
        /// The new `experience`, or none to leave it unchanged.
        experience: option<u32>,
    }

    record block-pos {
        x: s32,
        y: s32,
        z: s32,
    }

    record block-signal-outcome {
        /// The new `signal`, or none to leave it unchanged.
        signal: option<s32>,
    }

    record broadcast-message-outcome {
        cancel: bool,
        /// The new `line`, or none to leave it unchanged.
        line: option<text-json>,
    }

    record camera-distance-outcome {
        /// The new `distance`, or none to leave it unchanged.
        distance: option<f32>,
    }

    record camera-entity {
        position: list<f64>,
        previous: list<f64>,
        x-rot: f32,
        y-rot: f32,
        x-rot-o: f32,
        y-rot-o: f32,
        eye-height: f32,
        living: option<living-camera>,
        mount: option<tuple<f32, f64>>,
    }

    record camera-override-type {
        position: list<f64>,
        yaw: f32,
        pitch: f32,
        roll: f32,
        fov: f32,
    }

    record camera-shake-outcome {
        /// The new `shake`, or none to leave it unchanged.
        shake: option<native-shake>,
    }

    record can-eat-outcome {
        /// The new `can-eat`, or none to leave it unchanged.
        can-eat: option<bool>,
    }

    record can-player-sleep-outcome {
        /// The new `problem`, or none to leave it unchanged.
        problem: option<option<string>>,
    }

    enum capability-kind {
        items,
        fluids,
        energy,
    }

    variant capability-target {
        block(string),
        block-entity(string),
        item(string),
    }

    record chorus-fruit-teleport-outcome {
        cancel: bool,
        /// The new `target`, or none to leave it unchanged.
        target: option<list<f64>>,
    }

    record compute-fog-color-outcome {
        /// The new `rgb`, or none to leave it unchanged.
        rgb: option<list<f32>>,
    }

    record compute-fov-modifier-outcome {
        /// The new `modifier`, or none to leave it unchanged.
        modifier: option<f32>,
    }

    record compute-fov-outcome {
        /// The new `degrees`, or none to leave it unchanged.
        degrees: option<f32>,
    }

    enum corner {
        top-left,
        top-right,
        bottom-left,
        bottom-right,
    }

    /// What a mod does to the HUD corner layout (`Corners`).
    variant corner-command {
        /// `Corners::place`: reserve a box in a corner, so the next panels sit past it.
        reserve(corner-box),
    }

    enum hud-corner {
        top-left,
        top-right,
        bottom-left,
        bottom-right,
    }

    record corner-box {
        corner: hud-corner,
        width: f32,
        height: f32,
    }

    record critical-hit-outcome {
        /// The new `critical`, or none to leave it unchanged.
        critical: option<bool>,
        /// The new `damage-multiplier`, or none to leave it unchanged.
        damage-multiplier: option<f32>,
    }

    enum direction {
        down,
        up,
        north,
        south,
        west,
        east,
    }

    enum display-context-n2 {
        none,
        third-person-left-hand,
        third-person-right-hand,
        first-person-left-hand,
        first-person-right-hand,
        head,
        gui,
        ground,
        fixed,
        on-shelf,
    }

    record ender-pearl-teleport-outcome {
        cancel: bool,
        /// The new `target`, or none to leave it unchanged.
        target: option<list<f64>>,
        /// The new `damage`, or none to leave it unchanged.
        damage: option<f32>,
    }

    record experience-orb-can-merge-outcome {
        /// The new `can-merge`, or none to leave it unchanged.
        can-merge: option<bool>,
    }

    record experience-orb-pickup-outcome {
        cancel: bool,
        /// The new `value`, or none to leave it unchanged.
        value: option<u32>,
        /// The new `count`, or none to leave it unchanged.
        count: option<u32>,
    }

    record exploration-map {
        destination: string,
        decoration: string,
        zoom: u8,
        search-radius: s32,
        skip-existing-chunks: bool,
    }

    record fixed-frame-type {
        index: u64,
        fps: u32,
        size: tuple<u32, u32>,
        hud: bool,
        elapsed: u64,
        advance: frame-advance,
    }

    enum fluid-motion {
        water,
        lava,
        none,
    }

    record fog-data {
        color: list<f32>,
        environmental-start: f32,
        environmental-end: f32,
        render-distance-start: f32,
        render-distance-end: f32,
        sky-end: f32,
        cloud-end: f32,
    }

    enum fog-type {
        atmospheric,
        water,
        lava,
        powder-snow,
    }

    record food-level-changed-outcome {
        cancel: bool,
        /// The new `to`, or none to leave it unchanged.
        to: option<s32>,
    }

    record fov-player {
        flying: bool,
        walking-speed: f32,
        movement-speed: f64,
        using: option<tuple<use-item-type, s32>>,
    }

    record frame-advance {
        ticks: u32,
        partial-tick: f32,
    }

    /// What a mod draws over a frame stage (`WorldDrawn`, `HandDrawn`, `WorldPrePost`,
    /// `OverlayDrawn`), applied in order. Raw GPU access (device, encoder, depth) is not offered
    /// to WASM mods: these are whole-frame image operations the host performs on the stage's
    /// colour target.
    variant frame-command {
        /// Fills a rectangle of the target.
        fill-rect(frame-fill),
        /// Blends 0xAARRGGBB over the whole target.
        tint(u32),
        /// Darkens the edges: 0 is none, 1 is a full vignette.
        vignette(f32),
    }

    record frame-fill {
        /// In pixels of the target.
        x: u32,
        y: u32,
        width: u32,
        height: u32,
        /// 0xAARRGGBB.
        color: u32,
    }

    record framerate-limit-outcome {
        /// The new `limit`, or none to leave it unchanged.
        limit: option<s32>,
    }

    record global-pos {
        dimension: string,
        pos: list<s32>,
    }

    variant gui-draw {
        sprite(gui-draw-sprite),
        atlas-sprite(gui-draw-atlas-sprite),
        blit(gui-draw-blit),
        fill(gui-draw-fill),
        text(gui-draw-text),
        item(gui-draw-item),
        push(list<pose-op>),
        pop,
    }

    record gui-draw-atlas-sprite {
        sprite: string,
        x: s32,
        y: s32,
        w: s32,
        h: s32,
        color: u32,
    }

    record gui-draw-blit {
        texture: string,
        blend: blend,
        x: s32,
        y: s32,
        w: s32,
        h: s32,
        uv: list<f32>,
        src: list<s32>,
        tex: list<s32>,
        color: u32,
    }

    record gui-draw-fill {
        x0: s32,
        y0: s32,
        x1: s32,
        y1: s32,
        color: u32,
    }

    record gui-draw-item {
        slot: u32,
        x: s32,
        y: s32,
        seed: s32,
        scale: list<f32>,
        pivot: list<f32>,
    }

    record gui-draw-sprite {
        sprite: string,
        x: s32,
        y: s32,
        w: s32,
        h: s32,
        region: option<list<s32>>,
        color: u32,
        blend: blend,
    }

    record gui-draw-text {
        text: text-json,
        x: s32,
        y: s32,
        color: u32,
        shadow: bool,
    }

    record gui-layer-pre-outcome {
        cancel: bool,
        /// Commands to apply to `batch`, in order.
        commands: list<hud-command>,
    }

    enum hand {
        main,
        off,
    }

    record health-inputs {
        tick: s32,
        millis: s64,
        health: f32,
        max-health: f32,
        absorption: f32,
        armor: s32,
        food: s32,
        saturation: f32,
        kind: heart-kind,
        regeneration: bool,
        hunger: bool,
        hardcore: bool,
        damage-cooldown: bool,
        air: s32,
        max-air: s32,
        under-water: bool,
        vehicle-hearts: s32,
    }

    enum heart-kind {
        normal,
        poisoned,
        withered,
        frozen,
    }

    /// What a mod draws into the GUI batch (`HudBatch`), applied in order. GUI pixels; colours are
    /// 0xAARRGGBB, except text, whose alpha is its default colour's.
    variant hud-command {
        /// `HudBatch::text_styled`.
        text(hud-text),
        /// `HudBatch::fill`.
        rect(hud-rect),
        /// `HudBatch::fill_gradient`.
        gradient(hud-gradient),
        /// `HudBatch::fill_quad` for a flat colour, `HudBatch::quad` with a sprite.
        quad(hud-quad),
        /// `HudBatch::sprite`, `sprite_scaled`, `sprite_part` and `sprite_region`.
        sprite(hud-sprite),
        /// An item drawn as in an inventory slot.
        item(hud-item),
        /// A texture registered through the native GUI textures, by id.
        texture(hud-texture),
        /// `HudBatch::text_highlight`.
        highlight(hud-highlight),
        /// Starts a run that `end-clip` cuts to the rectangle (`HudBatch::clip_since`).
        begin-clip(hud-bounds),
        end-clip,
        /// Starts a run that `end-scale` scales about a point (`HudBatch::scale_since`).
        begin-scale(hud-scale),
        end-scale,
        /// Starts a run drawn with a blend mode until `end-blend` (`HudBatch::blend_since`).
        begin-blend(hud-blend),
        end-blend,
    }

    record hud-text {
        text: text-json,
        x: f32,
        y: f32,
        color: u32,
        shadow: bool,
    }

    record hud-rect {
        x: f32,
        y: f32,
        width: f32,
        height: f32,
        color: u32,
    }

    record hud-gradient {
        x: f32,
        y: f32,
        width: f32,
        height: f32,
        top: u32,
        bottom: u32,
    }

    record hud-quad {
        /// The four corners in order round the shape.
        corners: list<tuple<f32, f32>>,
        /// A sprite id, or none for a flat colour.
        sprite: option<string>,
        /// UVs of the corners, 0 to 1 over the sprite; none takes the sprite's own corners.
        uv: option<list<tuple<f32, f32>>>,
        color: u32,
    }

    record hud-sprite {
        name: string,
        x: f32,
        y: f32,
        /// The size drawn; none draws the sprite as large as it is.
        size: option<tuple<f32, f32>>,
        color: u32,
        /// Draw only this fraction of the width, from the left.
        fraction: option<f32>,
        /// Draw only this region (x, y, width, height) of a texture of the given size.
        region: option<hud-region>,
    }

    record hud-region {
        x: f32,
        y: f32,
        width: f32,
        height: f32,
        texture-width: f32,
        texture-height: f32,
    }

    record hud-item {
        stack: item-stack,
        x: f32,
        y: f32,
        /// Also draw the count and the damage bar.
        decorations: bool,
    }

    record hud-texture {
        id: string,
        x: f32,
        y: f32,
        width: f32,
        height: f32,
        color: u32,
    }

    record hud-highlight {
        x: f32,
        y: f32,
        width: f32,
        height: f32,
        invert-text: bool,
    }

    record hud-bounds {
        x0: f32,
        y0: f32,
        x1: f32,
        y1: f32,
    }

    record hud-scale {
        center-x: f32,
        center-y: f32,
        scale-x: f32,
        scale-y: f32,
    }

    enum hud-blend {
        alpha,
        invert,
        additive,
        vignette,
    }

    record hud-outcome {
        /// Commands to apply to `batch`, in order.
        batch-commands: list<hud-command>,
        /// Commands to apply to `corners`, in order.
        corners-commands: list<corner-command>,
    }

    record ingredient-test-outcome {
        /// The new `accept`, or none to leave it unchanged.
        accept: option<bool>,
    }

    record interaction-key-outcome {
        cancel: bool,
        /// The new `swing-hand`, or none to leave it unchanged.
        swing-hand: option<bool>,
    }

    record inventory-background-pre-outcome {
        cancel: bool,
        /// Commands to apply to `batch`, in order.
        commands: list<hud-command>,
    }

    record inventory-screen-layout-outcome {
        /// The new `layout`, or none to leave it unchanged.
        layout: option<native-inventory-layout>,
    }

    record is-signal-source-outcome {
        /// The new `source`, or none to leave it unchanged.
        source: option<bool>,
    }

    record item-bar-outcome {
        /// The new `bar`, or none to leave it unchanged.
        bar: option<option<tuple<s32, u32>>>,
    }

    record item-cost {
        stack: item-stack,
    }

    record item-damaged-outcome {
        cancel: bool,
        /// The new `amount`, or none to leave it unchanged.
        amount: option<s32>,
    }

    record item-energy-buffer-type {
        capacity: s32,
        max-insert: s32,
        max-extract: s32,
    }

    record item-expire-outcome {
        /// The new `extra-life`, or none to leave it unchanged.
        extra-life: option<s32>,
    }

    record item-model-context {
        display: display-context-n2,
        owner: option<owner-state>,
        level: option<level-state>,
        seed: s32,
    }

    record item-model-property-outcome {
        /// The new `value`, or none to leave it unchanged.
        value: option<bool>,
    }

    record item-render-outcome {
        value: option<bool>,
        /// Commands to apply to `draw`, in order.
        commands: list<model-command>,
    }

    record item-slot-cooldown-outcome {
        cancel: bool,
        /// Commands to apply to `batch`, in order.
        commands: list<hud-command>,
    }

    /// An item stack: item id, count and the data components (damage, enchantments, custom name,
    /// bundle and container contents...) as an `nbt` compound, the way Horizon writes them to the
    /// network and to disk. An empty `components` list means no components.
    record item-stack {
        id: string,
        count: u32,
        components: nbt,
    }

    /// A JSON document as text. Stand-in for `serde_json::Value`.
    type json = string;

    record key-event {
        key: str-view,
        pressed: u32,
    }

    enum level-dimension {
        overworld,
        nether,
        end,
    }

    record level-state {
        dimension: string,
        game-time: s64,
        sun-angle: f32,
        moon-phase: s32,
        respawn: option<global-pos>,
        runs-normally: bool,
    }

    record living-breathe-outcome {
        /// The new `can-breathe`, or none to leave it unchanged.
        can-breathe: option<bool>,
        /// The new `consume`, or none to leave it unchanged.
        consume: option<s32>,
        /// The new `refill`, or none to leave it unchanged.
        refill: option<s32>,
    }

    record living-camera {
        scale: f32,
        camera-distance: f64,
        sleeping: option<option<f32>>,
        dead: option<s32>,
    }

    record living-drown-outcome {
        cancel: bool,
        /// The new `is-drowning`, or none to leave it unchanged.
        is-drowning: option<bool>,
        /// The new `damage-amount`, or none to leave it unchanged.
        damage-amount: option<f32>,
    }

    record living-entity-use-item-finish-outcome {
        /// The new `result`, or none to leave it unchanged.
        %result: option<option<item-stack>>,
    }

    record living-entity-use-item-start-outcome {
        cancel: bool,
        /// The new `duration`, or none to leave it unchanged.
        duration: option<s32>,
    }

    record living-entity-use-item-tick-outcome {
        cancel: bool,
        /// The new `duration`, or none to leave it unchanged.
        duration: option<s32>,
    }

    record living-fall-outcome {
        cancel: bool,
        /// The new `distance`, or none to leave it unchanged.
        distance: option<f64>,
        /// The new `multiplier`, or none to leave it unchanged.
        multiplier: option<f32>,
    }

    record living-heal-outcome {
        cancel: bool,
        /// The new `amount`, or none to leave it unchanged.
        amount: option<f32>,
    }

    record living-incoming-damage-outcome {
        cancel: bool,
        /// The new `amount`, or none to leave it unchanged.
        amount: option<f32>,
    }

    record living-incoming-damage-v2-outcome {
        cancel: bool,
        /// The new `amount`, or none to leave it unchanged.
        amount: option<f32>,
    }

    record living-knockback-outcome {
        cancel: bool,
        /// The new `strength`, or none to leave it unchanged.
        strength: option<f64>,
        /// The new `x`, or none to leave it unchanged.
        x: option<f64>,
        /// The new `z`, or none to leave it unchanged.
        z: option<f64>,
    }

    record living-knockback-v2-outcome {
        cancel: bool,
        /// The new `strength`, or none to leave it unchanged.
        strength: option<f64>,
        /// The new `x`, or none to leave it unchanged.
        x: option<f64>,
        /// The new `z`, or none to leave it unchanged.
        z: option<f64>,
    }

    record loot-damage {
        kind: string,
        source: option<loot-entity>,
        direct: option<loot-entity>,
    }

    record loot-entity {
        kind: string,
        living: bool,
        on-fire: bool,
        baby: bool,
        /// opaque engine handle (LootEntity)
        vehicle: option<u64>,
        cube-size: option<s32>,
        sheep: option<tuple<string, bool>>,
        captain: option<bool>,
        frog-variant: option<string>,
        chicken-variant: option<string>,
        powered: bool,
        equipment: list<tuple<string, loot-stack>>,
    }

    record loot-stack {
        item: string,
        count: s32,
        damage: s32,
        enchantments: list<tuple<string, s32>>,
        potion: option<string>,
        %map: bool,
        exploration: option<exploration-map>,
        ominous-amplifier: option<s32>,
        stew-effects: list<tuple<string, s32>>,
        names: list<tuple<string, json>>,
        components: list<tuple<string, json>>,
    }

    record mending-repair-outcome {
        /// The new `repair`, or none to leave it unchanged.
        repair: option<u32>,
    }

    record menu-button-outcome {
        /// The new `entity`, or none to leave it unchanged.
        entity: option<mod-block-entity-fields>,
    }

    record menu-button-v2-outcome {
        /// The new `entity`, or none to leave it unchanged.
        entity: option<mod-block-entity-fields>,
        /// The new `carried`, or none to leave it unchanged.
        carried: option<option<item-stack>>,
    }

    record menu-quick-move-outcome {
        cancel: bool,
        /// The new `entity`, or none to leave it unchanged.
        entity: option<mod-block-entity-fields>,
        /// The new `stack`, or none to leave it unchanged.
        stack: option<item-stack>,
    }

    record menu-slot-rules-outcome {
        /// The new `may-place`, or none to leave it unchanged.
        may-place: option<bool>,
        /// The new `max-stack`, or none to leave it unchanged.
        max-stack: option<u32>,
    }

    record merchant-offer {
        base-cost-a: item-cost,
        cost-b: option<item-cost>,
        %result: item-stack,
        uses: s32,
        max-uses: s32,
        reward-exp: bool,
        special-price-diff: s32,
        demand: s32,
        price-multiplier: f32,
        xp: s32,
    }

    record mob-split-outcome {
        cancel: bool,
        /// The new `count`, or none to leave it unchanged.
        count: option<u32>,
    }

    record mob-submit-outcome {
        cancel: bool,
        /// Commands to apply to `draw`, in order.
        commands: list<model-command>,
    }

    record mod-block-entity-fields {
        id: string,
        nbt: nbt,
        items: list<option<item-stack>>,
        data: list<s32>,
    }

    record mod-container {
        slots: u64,
        faces: list<list<u64>>,
        inputs: list<u64>,
        outputs: list<u64>,
        menu: option<string>,
    }

    record mod-energy-buffer {
        capacity: s32,
        max-insert: s32,
        max-extract: s32,
        insert-faces: list<bool>,
        extract-faces: list<bool>,
    }

    record mod-fluid-tanks {
        tanks: list<s32>,
        faces: list<list<u64>>,
        inputs: list<u64>,
        outputs: list<u64>,
    }

    /// What a mod draws with a pose stack (`BlockEntityDraw`: block entities, mobs, players and
    /// items), applied in order. Blocks, +X east, +Y up, +Z south; colours 0xRRGGBB.
    variant model-command {
        /// `BlockEntityDraw::push`.
        push,
        /// `BlockEntityDraw::pop`.
        pop,
        /// `BlockEntityDraw::translate`, in blocks.
        translate(tuple<f32, f32, f32>),
        /// `BlockEntityDraw::rotate-about`.
        rotate-about(model-rotation),
        /// `BlockEntityDraw::scale`.
        scale(tuple<f32, f32, f32>),
        /// Sets `BlockEntityDraw::light` for what is drawn next (16 times sky light in bits 0..8,
        /// 16 times block light in bits 8..16).
        set-light(u32),
        /// `BlockEntityDraw::keep`: the block is drawn the same again until its state changes.
        keep,
        /// `native_draw_quad`.
        quad(model-quad),
        /// `native_draw_cube`.
        cube(model-cube),
        /// `native_draw_block`.
        block(model-block),
        /// `native_draw_model`: a standalone model by id.
        model(model-standalone),
        /// `native_draw_item`.
        item(model-item),
    }

    record model-rotation {
        axis: tuple<f32, f32, f32>,
        degrees: f32,
        pivot: tuple<f32, f32, f32>,
    }

    record model-quad {
        sprite: string,
        /// Four corners in blocks, in a model face's order.
        corners: list<tuple<f32, f32, f32>>,
        /// u0, v0, u1, v1 in texels of 16 per side.
        uv: list<f32>,
        tint: u32,
    }

    record model-cube-face {
        sprite: string,
        uv: option<list<f32>>,
    }

    record model-cube {
        min: tuple<f32, f32, f32>,
        max: tuple<f32, f32, f32>,
        /// Down, up, north, south, west, east; none leaves a face out.
        faces: list<option<model-cube-face>>,
        tint: u32,
    }

    record model-block {
        block: string,
        properties: list<tuple<string, string>>,
    }

    record model-standalone {
        model: string,
        tint: u32,
    }

    enum display-context {
        none,
        third-person-left-hand,
        third-person-right-hand,
        first-person-left-hand,
        first-person-right-hand,
        head,
        gui,
        ground,
        fixed,
        on-shelf,
    }

    record model-item {
        stack: item-stack,
        display: display-context,
        owner-yaw: option<f32>,
        seed: s32,
    }

    record mouse-buttons-outcome {
        /// The new `buttons`, or none to leave it unchanged.
        buttons: option<mouse-buttons-type>,
    }

    record mouse-buttons-type {
        attack-down: bool,
        use-down: bool,
        cancel-vanilla-attack: bool,
        cancel-vanilla-use: bool,
    }

    record movement-input-outcome {
        /// The new `forward`, or none to leave it unchanged.
        forward: option<f32>,
        /// The new `strafe`, or none to leave it unchanged.
        strafe: option<f32>,
        /// The new `jump`, or none to leave it unchanged.
        jump: option<bool>,
        /// The new `sneak`, or none to leave it unchanged.
        sneak: option<bool>,
    }

    record music-layer {
        sound: string,
        volume: f32,
    }

    record music-outcome {
        /// The new `music`, or none to leave it unchanged.
        music: option<option<music-type>>,
        /// The new `volume`, or none to leave it unchanged.
        volume: option<f32>,
    }

    record music-type {
        sound: string,
        min-delay: s32,
        max-delay: s32,
        replace-current-music: bool,
    }

    record name-tag-line {
        text: string,
        sprite: option<string>,
    }

    enum native-authority {
        local-authoritative,
        integrated-server,
        dedicated-server,
        remote-client,
    }

    record native-block-behavior {
        id: string,
        /// opaque engine handle (dyn BlockBehavior)
        behavior: u64,
    }

    record native-block-rim {
        pos: list<s32>,
        argb: u32,
        width: f32,
    }

    record native-capability-provider {
        target: capability-target,
        kind: capability-kind,
        /// opaque engine handle (dyn CapabilityProvider)
        provider: u64,
    }

    variant native-chat-recipients {
        all,
        only(list<list<u8>>),
    }

    record native-colored-light {
        at: list<f64>,
        rgb: u32,
        radius: f32,
        intensity: f32,
    }

    record native-command {
        usage: string,
        level: u8,
    }

    record native-data-map-type {
        id: string,
        registry: string,
    }

    record native-fluid-definition {
        id: string,
        flowing-id: string,
        still-block: string,
        flowing-block: string,
        bucket: string,
        still-texture: string,
        flowing-texture: string,
        tint: u32,
        viscosity: u8,
        tick-rate: u32,
        light: u8,
        can-drown: bool,
        motion: fluid-motion,
    }

    enum native-inventory-context {
        player-inventory,
        crafting-table,
        container,
    }

    record native-inventory-layout {
        offset: list<f32>,
        width: u32,
        show-crafting: bool,
    }

    record native-item-behavior {
        id: string,
        /// opaque engine handle (dyn ItemBehavior)
        behavior: u64,
    }

    enum native-item-context {
        first-person-right,
        first-person-left,
        third-person-right,
        third-person-left,
        gui,
        ground,
        fixed,
        head,
        item-display,
        on-shelf,
        none,
    }

    record native-item-holder {
        entity-id: option<s32>,
        is-local-player: bool,
        offhand: bool,
        using-item: bool,
        use-ticks: s32,
        swing-progress: option<f32>,
        partial-tick: f32,
    }

    record native-item-render-context {
        components: list<tuple<string, json>>,
        partial-tick: f32,
        game-time: s64,
        light: u32,
    }

    record native-lifecycle-context {
        authority: native-authority,
        epoch: u64,
        tick: u64,
    }

    record native-loot-context {
        entity: option<loot-entity>,
        damage: option<loot-damage>,
        player: option<loot-entity>,
        tool: option<native-loot-tool>,
        block: option<string>,
        luck: f32,
        biome: option<string>,
        seed: s64,
        place: option<native-loot-place>,
    }

    record native-loot-drops {
        table: string,
        dimension: string,
        origin: list<f64>,
        block: option<tuple<list<s32>, u32>>,
        entity: option<tuple<u32, string>>,
        player: option<list<u8>>,
        tool: option<item-stack>,
        explosion: option<f32>,
        used: bool,
    }

    record native-loot-level {
        dimension: string,
        game-time: s64,
        day-time: s64,
        raining: bool,
        thundering: bool,
    }

    record native-loot-place {
        origin: option<list<f64>>,
        block-entity: option<nbt>,
        level: option<native-loot-level>,
    }

    record native-loot-tool {
        item: string,
        enchantments: list<tuple<string, s32>>,
    }

    record native-map-decoration {
        sprite: string,
        x: s8,
        y: s8,
        rot: u8,
        shown-on-frame: bool,
    }

    record native-map-info {
        id: s32,
        center: list<s32>,
        scale: u8,
        dimension: string,
        locked: bool,
        in-frame: bool,
    }

    record native-menu-behavior {
        id: string,
        /// opaque engine handle (dyn MenuBehavior)
        behavior: u64,
    }

    record native-minimap {
        corner: corner,
        size: f32,
        blocks-per-pixel: f32,
        rotate: bool,
        round: bool,
    }

    record native-mob-render {
        id: u32,
        kind: string,
        custom-name: option<string>,
        baby: bool,
        partial: f32,
        age: f32,
        body-yaw: f32,
        head-yaw: f32,
        pitch: f32,
        walk-position: f32,
        walk-speed: f32,
        hurt-time: s32,
        death-time: s32,
        on-ground: bool,
    }

    record native-mod {
        id: string,
        title: string,
        description: string,
        keys: list<list<string>>,
    }

    record native-note-block-change {
        dimension: level-dimension,
        pos: block-pos,
        instrument: string,
        old-note: s32,
    }

    variant native-panel-event {
        clicked(native-panel-event-clicked),
        search(string),
        key(native-panel-event-key),
        slot-clicked(native-panel-event-slot-clicked),
        action(u32),
        page(u32),
        back,
        tab(u32),
    }

    record native-panel-event-clicked {
        index: u32,
        right: bool,
    }

    record native-panel-event-key {
        key: string,
        stack: native-stack,
    }

    record native-panel-event-slot-clicked {
        recipe: u32,
        slot: u32,
        stack: native-stack,
        right: bool,
    }

    record native-player-render {
        name: string,
        local: bool,
        uuid: option<list<u8>>,
        pose: string,
        crouch-amount: f32,
        swim-amount: f32,
        riding: bool,
        sleeping: bool,
        sprinting: bool,
        attack-progress: f32,
        swing-hand: hand,
        using-item: option<hand>,
        use-ticks: f32,
        main-hand-right: bool,
        main-hand: option<item-stack>,
        off-hand: option<item-stack>,
        armor: list<option<item-stack>>,
        elytra: bool,
        on-fire: bool,
        invisible: bool,
        glowing: bool,
        frozen-ticks: s32,
        in-water: bool,
        eye-in-water: bool,
        flying: option<bool>,
        health: option<f32>,
        max-health: option<f32>,
        food-level: option<s32>,
        right-arm-pose: string,
        left-arm-pose: string,
        scale: f32,
    }

    record native-recipe-type {
        id: string,
        version: u32,
        category: recipe-book-category,
        /// opaque engine handle (dyn NativeRecipeCodec)
        codec: u64,
    }

    record native-screen {
        width: f32,
        height: f32,
        slots: list<option<list<f32>>>,
        inventory-y: f32,
        inventory-x: f32,
        own-labels: bool,
        own-background: bool,
    }

    record native-screen-view {
        id: string,
        kind: option<string>,
        menu: option<string>,
        title: option<text-json>,
        extra: list<u8>,
        rect: list<f32>,
        slots: u64,
        mouse: list<f32>,
        partial-tick: f32,
        inventory-context: option<native-inventory-context>,
    }

    record native-server-player {
        uuid: list<u8>,
        name: string,
        permission: u8,
        dimension: string,
        position: list<f64>,
        game-mode: s32,
        health: f32,
        yaw: f32,
        pitch: f32,
    }

    record native-shake {
        pitch: f32,
        yaw: f32,
        roll: f32,
        offset: list<f32>,
    }

    record native-stack {
        item: string,
        count: u32,
        components: string,
    }

    record native-zoom {
        factor: f32,
        smooth: bool,
        turn: f32,
    }

    /// A binary NBT value in Horizon's network encoding: one tag id byte, then that tag's payload
    /// (no root name), big-endian, strings as Java modified UTF-8. A compound is tag id 10.
    /// Stand-in for the recursive `Tag` and `Compound`; the guest SDK has a parser and writer.
    type nbt = list<u8>;

    record net-frame-received-type {
        state: net-state,
        id: s32,
        body: list<u8>,
        /// opaque engine handle (Instant)
        at: u64,
        session: u64,
    }

    record net-frames-listened-outcome {
        /// The new `listened`, or none to leave it unchanged.
        listened: option<bool>,
    }

    enum net-state {
        login,
        configuration,
        play,
    }

    record note-block-change-outcome {
        cancel: bool,
        /// The new `new-note`, or none to leave it unchanged.
        new-note: option<s32>,
    }

    record owner-state {
        position: list<f64>,
        visual-rotation-y-degrees: f32,
        entity-type: string,
        main-arm-left: bool,
        using-this-item: bool,
        use-item-remaining-ticks: s32,
        use-duration: s32,
        crossbow-charge-duration: s32,
        fishing-cast-with-this-item: bool,
        is-selected: bool,
        is-carried: bool,
        is-view-entity: bool,
        team-color: option<s32>,
        cooldown-percent: f32,
        is-local-player: bool,
        last-death-location: option<global-pos>,
    }

    record placement-context {
        pos: block-pos,
        hit-pos: block-pos,
        face: direction,
        hit: vec3,
        inside: bool,
        yaw: f32,
        pitch: f32,
        sneaking: bool,
        item: string,
        replace-clicked: bool,
    }

    record player-command-outcome {
        cancel: bool,
        /// The new `replies`, or none to leave it unchanged.
        replies: option<list<text-json>>,
    }

    record player-exp-change-outcome {
        /// The new `amount`, or none to leave it unchanged.
        amount: option<s32>,
    }

    record player-login-outcome {
        cancel: bool,
        /// The new `reason`, or none to leave it unchanged.
        reason: option<option<text-json>>,
    }

    record player-permission-level-outcome {
        /// The new `level`, or none to leave it unchanged.
        level: option<u8>,
    }

    record player-submit-outcome {
        cancel: bool,
        /// Commands to apply to `draw`, in order.
        commands: list<model-command>,
    }

    record player-xp-change-outcome {
        cancel: bool,
        /// The new `amount`, or none to leave it unchanged.
        amount: option<s32>,
    }

    variant pose-op {
        translate(tuple<f32, f32>),
        scale(tuple<f32, f32>),
    }

    record potential-spawns-outcome {
        cancel: bool,
        /// The new `entries`, or none to leave it unchanged.
        entries: option<list<spawn-entry>>,
    }

    record prepare-anvil-outcome {
        value: option<item-stack>,
        /// The new `cost`, or none to leave it unchanged.
        cost: option<s32>,
    }

    record prepare-item-enchant-outcome {
        /// The new `costs`, or none to leave it unchanged.
        costs: option<list<s32>>,
    }

    record recipe-book-categories-outcome {
        /// The new `categories`, or none to leave it unchanged.
        categories: option<list<recipe-book-category>>,
    }

    record recipe-book-category {
        id: string,
        recipe-type: string,
        icon: string,
    }

    record release-using-outcome {
        /// The new `used`, or none to leave it unchanged.
        used: option<bool>,
    }

    record render-fog-outcome {
        /// The new `fog`, or none to leave it unchanged.
        fog: option<fog-data>,
    }

    record render-hand-pose-outcome {
        /// The new `x`, or none to leave it unchanged.
        x: option<f32>,
        /// The new `y`, or none to leave it unchanged.
        y: option<f32>,
        /// The new `z`, or none to leave it unchanged.
        z: option<f32>,
        /// The new `pitch`, or none to leave it unchanged.
        pitch: option<f32>,
        /// The new `yaw`, or none to leave it unchanged.
        yaw: option<f32>,
        /// The new `roll`, or none to leave it unchanged.
        roll: option<f32>,
        /// The new `scale`, or none to leave it unchanged.
        scale: option<f32>,
    }

    record render-name-tag-outcome {
        /// The new `visible`, or none to leave it unchanged.
        visible: option<bool>,
        /// The new `text`, or none to leave it unchanged.
        text: option<option<string>>,
    }

    record render-name-tag-position-outcome {
        /// The new `anchor`, or none to leave it unchanged.
        anchor: option<tuple<f64, f64, f64>>,
    }

    record render-needs-type {
        entity-spans: bool,
        world-depth: bool,
        pre-post: bool,
        overlay: bool,
    }

    record server-chat-outcome {
        cancel: bool,
        /// The new `message`, or none to leave it unchanged.
        message: option<string>,
        /// The new `recipients`, or none to leave it unchanged.
        recipients: option<native-chat-recipients>,
        /// The new `system`, or none to leave it unchanged.
        system: option<bool>,
    }

    variant server-tick-phase {
        server-tick-start(server-tick-phase-server-tick-start),
        server-tick-end(server-tick-phase-server-tick-end),
    }

    record server-tick-phase-server-tick-end {
        world-running: bool,
    }

    record server-tick-phase-server-tick-start {
        world-running: bool,
    }

    record shader-params-outcome {
        /// The new `params`, or none to leave it unchanged.
        params: option<list<list<f32>>>,
    }

    record should-apply-effect-tick-this-tick-outcome {
        /// The new `apply`, or none to leave it unchanged.
        apply: option<bool>,
    }

    record sign-changed-outcome {
        cancel: bool,
        /// The new `lines`, or none to leave it unchanged.
        lines: option<list<string>>,
    }

    record sleep-finished-time-outcome {
        /// The new `new-time`, or none to leave it unchanged.
        new-time: option<s64>,
    }

    record spawn-entry {
        entity: string,
        weight: u32,
        min: u32,
        max: u32,
        constant: bool,
    }

    record stack-view {
        item: string,
        count: s32,
        patch: list<tuple<string, option<json>>>,
        bundle-selected: s32,
    }

    record str-view {
        /// opaque engine handle (* const u8)
        ptr: u64,
        len: u64,
    }

    record suggestion {
        range: tuple<u64, u64>,
        text: string,
        tooltip: option<string>,
        int-value: option<s32>,
    }

    /// A text component as vanilla's JSON (`ComponentSerialization`). Stand-in for `Text`.
    type text-json = string;

    record tooltip-color-outcome {
        /// The new `background`, or none to leave it unchanged.
        background: option<u32>,
        /// The new `border-top`, or none to leave it unchanged.
        border-top: option<u32>,
        /// The new `border-bottom`, or none to leave it unchanged.
        border-bottom: option<u32>,
    }

    record use-animation-outcome {
        /// The new `animation`, or none to leave it unchanged.
        animation: option<use-animation-type>,
    }

    enum use-animation-type {
        none,
        eat,
        drink,
        block,
        bow,
        trident,
        crossbow,
        spyglass,
        toot-horn,
        brush,
        bundle,
        spear,
    }

    record use-duration-outcome {
        /// The new `duration`, or none to leave it unchanged.
        duration: option<s32>,
    }

    enum use-item-type {
        bow,
        spyglass,
        other,
    }

    record vec3 {
        x: f64,
        y: f64,
        z: f64,
    }

    record vehicle-damage-outcome {
        cancel: bool,
        /// The new `damage`, or none to leave it unchanged.
        damage: option<f32>,
    }

    record visuals-outcome {
        /// The new `rims`, or none to leave it unchanged.
        rims: option<list<native-block-rim>>,
        /// The new `lights`, or none to leave it unchanged.
        lights: option<list<native-colored-light>>,
    }

    enum world-phase {
        world-open-ready,
        world-open-failed,
        world-close-final,
        world-close-failed,
    }
}

interface server-types {
    enum attribute-operation {
        add-value,
        add-multiplied-base,
        add-multiplied-total,
    }

    enum config-value-kind {
        %bool,
        int,
        float,
        %string,
        %enum,
        bool-list,
        int-list,
        float-list,
        string-list,
        enum-list,
    }

    enum damage-kind {
        magic,
        player-attack,
        explosion,
    }

    enum inventory-operation {
        give,
        clear,
    }

    enum storage-scope {
        %world,
        global,
        client,
    }

    enum team-operation {
        add,
        remove,
        join,
        leave,
        modify,
    }

    enum world-control-operation {
        set-time,
        set-game-rule,
        add-force-load,
        remove-force-load,
    }

    record advancement-state {
        completed: list<string>,
        done: bool,
        known: bool,
        remaining: list<string>,
    }

    record attribute-value {
        base: f64,
        value: f64,
    }

    record block-edit {
        filters: list<string>,
        palette: list<string>,
        runs: list<block-run>,
    }

    record block-entity-create {
        entity-type: string,
    }

    record block-entity-patch {
        clock: option<s64>,
        state: option<string>,
    }

    record block-entity-state {
        clock: option<s64>,
        entity-type: string,
        state: option<string>,
    }

    record block-pos {
        x: s32,
        y: s32,
        z: s32,
    }

    record block-run {
        block: u32,
        height: u32,
        only: option<u32>,
        surface: option<string>,
        x: s32,
        y: s32,
        z: s32,
    }

    record bounds {
        max: vec3,
        min: vec3,
    }

    record chat-decision {
        cancel: bool,
        message: string,
        recipients: chat-recipients,
        system: bool,
    }

    record chat-recipients {
        all: bool,
        only: list<string>,
    }

    record command-usage {
        level: u8,
        usage: string,
    }

    record config-value {
        bool-list: list<bool>,
        bool-value: bool,
        float-list: list<f64>,
        float-value: f64,
        int-list: list<s64>,
        int-value: s64,
        kind: config-value-kind,
        string-list: list<string>,
        string-value: string,
    }

    record container-ref {
        block: string,
        kind: string,
        position: block-pos,
        slots: u32,
    }

    record damage-decision {
        amount: f32,
        cancel: bool,
    }

    record entity-snapshot {
        alive: bool,
        bounds: bounds,
        dimension: string,
        handle: u32,
        kind: string,
        player-uuid: option<string>,
        position: vec3,
    }

    record entity-vitals {
        absorption: f32,
        armor: f32,
        health: f32,
        max-health: f32,
    }

    record inventory-change {
        components: option<list<u8>>,
        count: u32,
        item: string,
        operation: inventory-operation,
    }

    record item-entity {
        handle: u32,
        position: vec3,
        stack: item-stack,
        velocity: vec3,
    }

    record item-stack {
        components: list<u8>,
        count: u32,
        item: string,
    }

    record knockback-decision {
        cancel: bool,
        strength: f64,
        x: f64,
        z: f64,
    }

    record particle-request {
        count: u32,
        particle: string,
        players: list<string>,
        position: vec3,
        speed: f32,
        spread: vec3,
    }

    record player {
        dimension: string,
        game-mode: s32,
        health: f32,
        name: string,
        permission-level: u8,
        pitch: f32,
        position: vec3,
        sneaking: bool,
        uuid: string,
        yaw: f32,
    }

    record player-inventory-slot {
        id: u32,
        stack: option<item-stack>,
    }

    record player-motion {
        fall-distance: f64,
        horizontal-collision: bool,
        on-ground: bool,
        position: vec3,
        velocity: vec3,
    }

    record ray-hit {
        block: block-pos,
        face: string,
        position: vec3,
    }

    record team-change {
        operation: team-operation,
        players: list<string>,
        property: option<string>,
        team: string,
        value: option<string>,
    }

    record tool-requirement {
        hardness: f32,
        mineable: list<string>,
        requires-tool: bool,
        tier: option<string>,
    }

    record vec3 {
        x: f64,
        y: f64,
        z: f64,
    }

    record world-border-state {
        center-x: f64,
        center-z: f64,
        remaining-ticks: u64,
        size: f64,
        target-size: f64,
    }

    record world-control-change {
        dimension: string,
        %from: option<block-pos>,
        key: string,
        operation: world-control-operation,
        to: option<block-pos>,
        value: string,
    }
}

/// Services listed in `abi-subset-server.json`.
interface server-services {
