    post-shader-state: func(id: string) -> result<bool, string>;
    map-columns: func(below: option<s32>, chunk: tuple<s32, s32>) -> result<option<map-tile>, string>;
    client-players: func() -> result<list<map-player>, string>;
    client-entities-in: func(center: vec3, radius: f64) -> result<list<map-entity>, string>;
    camera: func() -> result<option<camera-state>, string>;
    camera-override-call: func(value: option<camera-override>) -> result<_, string>;
    gui-texture-write: func(bytes: list<u8>, origin: tuple<u32, u32>, size: tuple<u32, u32>, texture: borrow<gui-texture>) -> result<_, string>;
    audio-stream-open: func(anchor: pcm-anchor, category: string, channels: u16, sample-rate: u32) -> result<u32, string>;
    audio-stream-push: func(samples: list<f32>, %stream: u32) -> result<u32, string>;
    audio-stream-push-i16: func(samples: list<s16>, %stream: u32) -> result<u32, string>;
    audio-stream-queued: func(%stream: u32) -> result<option<u32>, string>;
    audio-stream-dropped: func(%stream: u32) -> result<option<u64>, string>;
    audio-stream-move: func(anchor: pcm-anchor, %stream: u32) -> result<_, string>;
    audio-stream-close: func(%stream: u32) -> result<bool, string>;
    hud-place: func(corner: hud-corner, size: vec2) -> result<option<vec2>, string>;
    map-colors: func() -> result<list<u32>, string>;
    draw-mob-as-player: func(appearance: list<u8>) -> result<bool, string>;
    config-get: func(key: string) -> result<config-value, string>;
    config-set: func(key: string, value: config-value) -> result<_, string>;
    storage-get: func(key: string, scope: storage-scope) -> result<option<list<u8>>, string>;
    storage-put: func(key: string, scope: storage-scope, value: list<u8>) -> result<_, string>;
    storage-delete: func(key: string, scope: storage-scope) -> result<bool, string>;
    storage-blob-begin: func(key: string, scope: storage-scope, total: u64) -> result<u64, string>;
    storage-blob-write: func(data: list<u8>, id: u64, offset: u64) -> result<_, string>;
    storage-blob-commit: func(id: u64) -> result<_, string>;
    storage-blob-abort: func(id: u64) -> result<bool, string>;
    storage-blob-read: func(key: string, length: u32, offset: u64, scope: storage-scope) -> result<list<u8>, string>;
