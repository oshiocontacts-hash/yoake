(component
  (import "original-f" (func $orig (param "x" s32) (result s32)))
  (import "original-h" (func $origh (param "x" s32) (result s32)))
  (import "original-p" (func $origp (param "d" (list u8)) (result s32)))
  (core module $mem
    (memory (export "memory") 2)
    (global $heap (mut i32) (i32.const 1024))
    (func (export "realloc") (param i32 i32 i32 i32) (result i32)
      (local $p i32)
      ;; bump allocator; reset when the heap grows past 60000
      (if (i32.gt_u (global.get $heap) (i32.const 60000)) (then (global.set $heap (i32.const 1024))))
      (local.set $p (global.get $heap))
      (global.set $heap (i32.add (local.get $p) (local.get 3)))
      (local.get $p)))
  (core instance $mi (instantiate $mem))
  (core func $of (canon lower (func $orig)))
  (core func $oh (canon lower (func $origh)))
  (core func $op (canon lower (func $origp) (memory (core memory $mi "memory"))))
  (core module $m
    (import "env" "original_f" (func $of (param i32) (result i32)))
    (import "env" "original_h" (func $oh (param i32) (result i32)))
    (import "env" "original_p" (func $op (param i32 i32) (result i32)))
    (func (export "hook_f") (param i32) (result i32)
      (i32.add (call $of (local.get 0)) (i32.const 1000)))
    (func (export "hook_g") (param i32) (result i32)
      (i32.add (local.get 0) (i32.const 1)))
    (func (export "hook_trap") (param i32) (result i32) (unreachable))
    (func (export "hook_h") (param i32) (result i32) (call $oh (local.get 0)))
    (func (export "hook_p") (param i32 i32) (result i32) (call $op (local.get 0) (local.get 1))))
  (core instance $i (instantiate $m (with "env" (instance
    (export "original_f" (func $of)) (export "original_h" (func $oh)) (export "original_p" (func $op))))))
  (func (export "hook-f") (param "x" s32) (result s32) (canon lift (core func $i "hook_f")))
  (func (export "hook-g") (param "x" s32) (result s32) (canon lift (core func $i "hook_g")))
  (func (export "hook-trap") (param "x" s32) (result s32) (canon lift (core func $i "hook_trap")))
  (func (export "hook-h") (param "x" s32) (result s32) (canon lift (core func $i "hook_h")))
  (func (export "hook-p") (param "d" (list u8)) (result s32)
    (canon lift (core func $i "hook_p") (memory (core memory $mi "memory")) (realloc (core func $mi "realloc"))))
)
